{
    "name": "nails/driver-multi-factor-auth-authenticator",
    "description": "Authenticator MFA Driver for Nails",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "php": ">=8.3",
        "nails/module-multi-factor-auth": "dev-feature/pre-new-admin",
        "spomky-labs/otphp": "^11.5",
        "psr/clock": "^1.0",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload": {
        "psr-4": {
            "Nails\\MFA\\Driver\\Authentication\\": "src/",
            "Nails\\MFA\\Driver\\Authentication\\Authenticator\\": "src/Authenticator/"
        }
    },
    "extra": {
        "nails": {
            "type": "driver",
            "subType": "authentication",
            "forModule": "nails/module-multi-factor-auth",
            "namespace": "Nails\\MFA\\Driver\\Authentication\\Authenticator\\",
            "data": {
                "namespace": "Nails\\MFA\\Driver\\Authentication\\",
                "class": "Authenticator"
            }
        }
    }
}
